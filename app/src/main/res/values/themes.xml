<resources>
    <style name="Theme.TradingJournal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
    </style>
    <style name="Theme.TradingJournal.Splash" parent="Theme.TradingJournal">
